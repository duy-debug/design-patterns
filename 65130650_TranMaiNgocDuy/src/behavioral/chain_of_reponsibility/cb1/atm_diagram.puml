@startuml
'https://plantuml.com/class-diagram

abstract class MoneyDispenser{
# nextDispenser: MoneyDispenser
+ void setNetDispenser(MoneyDispenser nextDispenser): void
+ {abstract} void dispenser(int amount)
}
class DemonitationDispenser{
- int demoination
+ DemonitationDispenser(int demonitation)
+ void dispenser(int amount)
}
class Clien{}
class ATM_Machine{
+ MoneyDispenser getDispenserChain(int maxDemonitation)
}
Clien ..> ATM_Machine: user
ATM_Machine ..> MoneyDispenser: creates getDispenserChain
MoneyDispenser --> MoneyDispenser: nextDispenser
MoneyDispenser <|-- DemonitationDispenser



@enduml